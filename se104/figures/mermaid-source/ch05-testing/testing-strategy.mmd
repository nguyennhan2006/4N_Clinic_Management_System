flowchart LR
    Req["Requirements<br/>REQ / UC / BR"]
    Design["Design<br/>DB / API / UI / Sequence"]
    Impl["Implementation<br/>Backend + Frontend"]
    Unit["Component / Unit Test<br/>Service-level where available"]
    API["API / E2E Test<br/>Phase 1 core flows"]
    UI["UI Manual Test<br/>Screenshots + checklist"]
    Reg["Regression Test<br/>Phase 1 after Phase 2 changes"]
    Accept["Acceptance Evidence<br/>Pass/fail table + logs"]

    Req -->|"specification drives design"| Design
    Design -->|"implemented as modules"| Impl
    Impl -->|"validate components"| Unit
    Unit -->|"validate endpoints + business rules"| API
    API -->|"validate user workflows"| UI
    UI -->|"re-test affected flows"| Reg
    Reg -->|"report evidence"| Accept

    Req -.->|"acceptance criteria"| Accept
    Design -.->|"API contract / DB rules"| API
    Impl -.->|"changed code triggers regression"| Reg

    Note["Current report wording:<br/>E2E tests cover Phase 1 core flows.<br/>Phase 2 needs manual evidence or future automated tests."]
    API -.-> Note

    classDef req fill:#DBEAFE,stroke:#1D4ED8,color:#111827;
    classDef design fill:#CCFBF1,stroke:#0F766E,color:#111827;
    classDef impl fill:#DCFCE7,stroke:#15803D,color:#111827;
    classDef test fill:#FFEDD5,stroke:#EA580C,color:#111827;
    classDef manual fill:#FCE7F3,stroke:#BE185D,color:#111827;
    classDef evidence fill:#F1F5F9,stroke:#475569,color:#111827;

    class Req req;
    class Design design;
    class Impl impl;
    class Unit,API,Reg test;
    class UI manual;
    class Accept,Note evidence;

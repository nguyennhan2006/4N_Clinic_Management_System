flowchart LR
    Staff["Clinic Staff<br/>Admin / Receptionist / Doctor<br/>Cashier / Manager / Nurse<br/>Lab / Pharmacist"]

    subgraph Device["User Device"]
        Browser["Web Browser<br/>Chrome / Edge"]
    end

    subgraph App["4N Clinic Management System"]
        FE["Frontend SPA<br/>React + Vite + TypeScript<br/>Role-based UI<br/>Protected routes"]
        BE["Backend REST API<br/>NestJS + TypeScript<br/>JWT Auth + RBAC<br/>Business Rules<br/>Swagger API Docs"]
        Prisma["Prisma ORM<br/>Schema mapping<br/>Migrations<br/>Typed database access"]
        Swagger["Swagger UI<br/>API documentation<br/>Manual API testing"]
        DB[("PostgreSQL Database<br/>Relational data store<br/>37 models / 12 enums<br/>Migration + Seed")]
    end

    Staff -->|"uses"| Browser
    Browser -->|"renders SPA"| FE
    FE -->|"HTTPS / JSON REST API<br/>Bearer Token"| BE
    BE -->|"calls PrismaService"| Prisma
    Prisma -->|"SQL queries"| DB
    BE -.->|"exposes /api/docs"| Swagger


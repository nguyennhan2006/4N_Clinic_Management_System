    classDef p1s   fill:#DBEAFE,stroke:#1D4ED8,color:#111827;
    classDef p2s   fill:#FFF7ED,stroke:#EA580C,color:#111827;
    classDef data  fill:#F3E8FF,stroke:#7E22CE,color:#111827;

    class FE fe;
    class Gateway gw;
    class P1 p1s;
    class P2 p2s;
    class Data data;

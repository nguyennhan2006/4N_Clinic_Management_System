flowchart TB
    FE["Frontend SPA (React + Vite)"]

    subgraph Gateway["API Gateway & Cross-cutting"]
        direction LR
        HTTP["REST Controllers\n@Controller / @Get / @Post / @Patch\nDTO Validation · Swagger Docs"]
        Guards["JwtAuthGuard · RolesGuard\nException Filters · CORS"]
    end

    subgraph P1["Phase 1 Core Services"]
        direction LR
        Identity["auth · users · rbac"]
        Clinical["patients · visits · examinations\nprescriptions · diseases · drugs"]
        BillRep["billing · regulations · reports"]
    end

    subgraph P2["Phase 2 Extension Services"]
        direction LR
        AptQ["appointments · queue · vitals"]
        SvcLab["services · lab"]
        InvPhOrgAudit["inventory · pharmacy\norganization · audit"]
    end

    subgraph Data["Data Layer"]
        direction LR
        Prisma["PrismaService (ORM)"]
        DB[("PostgreSQL Database")]
    end

    FE --> HTTP
    HTTP --> Guards
    Guards --> Identity
    Guards --> Clinical
    Guards --> BillRep
    Guards --> AptQ
    Guards --> SvcLab
    Guards --> InvPhOrgAudit
    Identity --> Prisma
    Clinical --> Prisma
    BillRep --> Prisma
    AptQ --> Prisma
    SvcLab --> Prisma
    InvPhOrgAudit --> Prisma
    Prisma --> DB


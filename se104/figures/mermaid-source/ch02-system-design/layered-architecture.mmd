flowchart TB
    Client["Client Layer<br/>Web Browser / React SPA"]

    subgraph Frontend["Frontend Layer"]
        Routes["Protected Routes<br/>Role-based navigation"]
        Pages["Feature Pages<br/>Patients / Visits / Exams / Billing / Phase 2"]
        ApiClient["API Client<br/>JWT bearer token<br/>JSON request/response"]
    end

    subgraph Backend["Backend Application Layer - NestJS"]
        Controllers["Controller Layer<br/>REST endpoints<br/>Swagger decorators"]
        Guards["Security Layer<br/>JwtAuthGuard<br/>RolesGuard"]
        DTO["Validation Layer<br/>DTO + class-validator"]
        Services["Service Layer<br/>Business rules<br/>Transactions"]
        PrismaService["Data Access Layer<br/>PrismaService"]
    end

    subgraph Data["Persistence Layer"]
        DB[("PostgreSQL Database<br/>37 models / 12 enums")]
        Migration["Prisma Migration + Seed<br/>Schema evolution<br/>Demo data"]
    end

    Client --> Routes
    Routes --> Pages
    Pages --> ApiClient
    ApiClient -->|"HTTPS REST API<br/>Bearer Token"| Controllers
    Guards -.-> Controllers
    Controllers --> DTO
    Controllers --> Services
    Services --> PrismaService
    PrismaService --> DB
    Migration --> DB


flowchart LR
    subgraph R["Receptionist"]
        R1["Login"]
        R2["Search Patient"]
        R3{"Patient exists?"}
        R4["Select Patient"]
        R5["Create Patient Profile"]
        R6["Create Visit"]
        R7["Assign Queue Number"]
        R8["Visit status = WAITING"]
    end

    subgraph D["Doctor"]
        D1["Open Examination"]
        D2["Visit status = IN_EXAM"]
        D3["Enter Symptoms / Diagnosis"]
        D4["Select Disease Reference"]
        D5["Create Prescription"]
        D6{"Need service / lab?"}
        D7["Order Service / Lab Test"]
        D8["Wait for Required Result"]
        D9["Complete Examination"]
        D10["Visit status = DONE"]
    end

    subgraph C["Cashier"]
        C1["Generate Invoice"]
        C2["Review Invoice Items"]
        C3["Record Payment"]
        C4{"Paid fully?"}
        C5["Invoice status = PAID"]
        C6["Invoice status = PARTIAL"]
    end

    subgraph M["Manager"]
        M1["Open Monthly Report"]
        M2["Review Visit Count"]
        M3["Review Revenue Summary"]
    end

    R1 --> R2 --> R3
    R3 -- Yes --> R4
    R3 -- No --> R5
    R4 --> R6
    R5 --> R6
    R6 --> R7 --> R8

    R8 --> D1
    D1 --> D2 --> D3 --> D4 --> D5 --> D6
    D6 -- Yes --> D7 --> D8 --> D9
    D6 -- No --> D9
    D9 --> D10

    D10 --> C1
    C1 --> C2 --> C3 --> C4
    C4 -- Yes --> C5
    C4 -- No --> C6

    C5 --> M1
    C6 --> M1
    M1 --> M2 --> M3

    classDef receptionist fill:#CCFBF1,stroke:#0F766E,color:#111827;
    classDef doctor fill:#DCFCE7,stroke:#15803D,color:#111827;
    classDef cashier fill:#FFEDD5,stroke:#EA580C,color:#111827;
    classDef manager fill:#F3E8FF,stroke:#7E22CE,color:#111827;

    class R1,R2,R3,R4,R5,R6,R7,R8 receptionist;
    class D1,D2,D3,D4,D5,D6,D7,D8,D9,D10 doctor;
    class C1,C2,C3,C4,C5,C6 cashier;
    class M1,M2,M3 manager;

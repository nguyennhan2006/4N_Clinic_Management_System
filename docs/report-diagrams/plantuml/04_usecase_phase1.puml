@startuml
!include common-style.puml

title Use Case Diagram - Phase 1\nCore clinic workflow

left to right direction

actor Admin
actor Receptionist
actor Doctor
actor Cashier
actor Manager

rectangle "4N Clinic Management System - Phase 1" as System {
  package "Authentication & Access" {
    usecase "UC01\nDang nhap" as UC01
    usecase "UC02\nQuan ly tai khoan" as UC02
    usecase "UC03\nQuan ly vai tro / quyen" as UC03
  }

  package "Patient & Visit" {
    usecase "UC04\nTra cuu ho so benh nhan" as UC04
    usecase "UC05\nTao / cap nhat ho so benh nhan" as UC05
    usecase "UC06\nTao luot kham" as UC06
    usecase "UC07\nXem danh sach luot kham" as UC07
  }

  package "Examination & Prescription" {
    usecase "UC08\nMo phien kham" as UC08
    usecase "UC09\nGhi phieu kham" as UC09
    usecase "UC10\nChan doan benh" as UC10
    usecase "UC11\nKe don thuoc" as UC11
    usecase "UC12\nXem lich su kham" as UC12
  }

  package "Billing" {
    usecase "UC13\nLap hoa don" as UC13
    usecase "UC14\nGhi nhan thanh toan" as UC14
  }

  package "Catalog, Regulation & Report" {
    usecase "UC15\nQuan ly danh muc benh" as UC15
    usecase "UC16\nQuan ly danh muc thuoc" as UC16
    usecase "UC17\nQuan ly quy dinh" as UC17
    usecase "UC18\nXem bao cao thang" as UC18

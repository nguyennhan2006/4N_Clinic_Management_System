%% SEQ-P2-04 A4 REPORT — Dispense Reversal (PLANNED). Full: SEQ_P2_04_DispenseReversal.mmd
sequenceDiagram
    autonumber
    actor PH as Pharmacist
    participant FE as React SPA
    participant GD as Guard
    participant CT as PharmCtrl
    participant SV as PharmSvc
    participant TX as Prisma Tx
    participant DB as PostgreSQL
    participant AU as Audit

    note over CT,SV: PLANNED Phase 2A - not implemented
    PH->>FE: Reverse a dispense
    FE->>GD: PATCH /pharmacy/dispense/:id/reverse + token
    GD->>GD: verify JWT + role
    alt not authorized
        GD-->>FE: 401 / 403
    else authorized
        GD->>CT: proceed
        CT->>SV: reverse(dispenseId, actorId)
        SV->>DB: find dispense + invoice state
        alt not found
            SV-->>CT: throw 404
            CT-->>FE: 404 dispense not found
        else already reversed
            SV-->>CT: throw 409
            CT-->>FE: 409 already reversed
        else invoice PAID
            SV-->>CT: throw 409 (BR-P2-12)
            CT-->>FE: 409 cannot reverse after payment
        else reversible
            rect rgb(235,235,255)
                note over TX: BEGIN transaction
                SV->>TX: reverse atomically
                loop each dispense item
                    TX->>DB: stock movement REVERSAL + increment
                end
                TX->>DB: Dispense -> REVERSED
                note over TX: COMMIT
            end
            SV->>AU: log STOCK_MOVEMENT
            SV-->>CT: dispense REVERSED
            CT-->>FE: 200 dispense
            FE-->>PH: Stock restored
        end
    end

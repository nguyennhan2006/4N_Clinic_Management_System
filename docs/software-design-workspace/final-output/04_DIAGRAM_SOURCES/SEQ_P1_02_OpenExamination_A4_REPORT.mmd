%% SEQ-P1-02 A4 REPORT — Open Examination (UC09). Full: SEQ_P1_02_OpenExamination.mmd
sequenceDiagram
    autonumber
    actor DR as Doctor
    participant FE as React SPA
    participant GD as Guard
    participant CT as VisitsCtrl
    participant SV as VisitsSvc
    participant TX as Prisma Tx
    participant DB as PostgreSQL
    participant AU as Audit

    DR->>FE: Open exam for waiting visit
    FE->>GD: POST /visits/:id/open-examination + token
    GD->>GD: verify JWT + role
    alt not authorized
        GD-->>FE: 401 / 403
    else authorized
        GD->>CT: proceed
        CT->>SV: openExamination(visitId, doctorId)
        SV->>DB: find doctor (pre-check, outside Tx)
        alt doctor inactive / missing
            SV-->>CT: throw 400
            CT-->>FE: 400 doctor inactive
        else doctor active
            rect rgb(235,235,255)
                note over TX: BEGIN transaction
                SV->>TX: open exam atomically
                TX->>DB: find visit + examination
                alt visit not found
                    TX-->>SV: throw 404
                    SV-->>CT: propagate
                    CT-->>FE: 404 visit not found
                else exam already exists
                    TX-->>SV: throw 409
                    SV-->>CT: propagate
                    CT-->>FE: 409 exam exists
                else status not WAITING
                    TX-->>SV: throw 400
                    SV-->>CT: propagate
                    CT-->>FE: 400 not WAITING
                else WAITING
                    TX->>DB: create Examination OPEN
                    TX->>DB: update Visit IN_EXAMINATION
                    note over TX: WAITING -> IN_EXAMINATION
                end
                note over TX: COMMIT
            end
            SV->>AU: log OPEN_EXAMINATION
            SV-->>CT: examination
            CT-->>FE: 201 examination
            FE-->>DR: Examination opened
        end
    end

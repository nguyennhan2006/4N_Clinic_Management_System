%% SEQ-P1-04 A4 REPORT — Upsert Prescription (UC12). Full: SEQ_P1_04_UpsertPrescription.mmd
sequenceDiagram
    autonumber
    actor DR as Doctor
    participant FE as React SPA
    participant GD as Guard
    participant CT as ExamCtrl
    participant SV as ExamSvc
    participant TX as Prisma Tx
    participant DB as PostgreSQL

    DR->>FE: Add drug lines
    FE->>GD: PUT /examinations/:id/prescription {dto} + token
    GD->>GD: verify JWT + role
    alt not authorized
        GD-->>FE: 401 / 403
    else authorized
        GD->>CT: proceed
        note over CT: Validate DTO
        alt invalid DTO
            CT-->>FE: 400 invalid DTO
        else valid DTO
            CT->>SV: upsertPrescription(id, dto)
            SV->>DB: find examination + prescription
            alt not found
                SV-->>CT: throw 404
                CT-->>FE: 404 exam not found
            else COMPLETED
                SV-->>CT: throw 400
                CT-->>FE: 400 exam completed
            else empty items
                SV-->>CT: throw 400
                CT-->>FE: 400 need >= 1 item
            else editable
                rect rgb(235,235,255)
                    note over TX: BEGIN transaction (BR-08 replace-all)
                    SV->>TX: replace prescription
                    TX->>DB: check drugs active
                    alt drug invalid/inactive
                        TX-->>SV: throw 400
                        SV-->>CT: propagate
                        CT-->>FE: 400 drug inactive
                    else ok
                        note over TX: unitPrice = drug.price (snapshot)
                        opt prescription exists
                            TX->>DB: delete old prescription
                        end
                        TX->>DB: create prescription + items
                    end
                    note over TX: COMMIT
                end
                SV-->>CT: prescription
                CT-->>FE: 200 prescription
                FE-->>DR: Prescription saved
            end
        end
    end

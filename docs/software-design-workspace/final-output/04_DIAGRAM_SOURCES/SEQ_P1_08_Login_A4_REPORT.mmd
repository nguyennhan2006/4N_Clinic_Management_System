%% SEQ-P1-08 A4 REPORT — Login (UC01, PUBLIC no guard). Full: SEQ_P1_08_Login.mmd
sequenceDiagram
    autonumber
    actor U as User
    participant FE as React SPA
    participant CT as AuthCtrl
    participant SV as AuthSvc
    participant DB as PostgreSQL
    participant AU as Audit

    U->>FE: Enter username + password
    FE->>CT: POST /auth/login {dto}
    note over CT: PUBLIC route - Validate DTO
    alt invalid DTO
        CT-->>FE: 400 invalid DTO
    else valid DTO
        CT->>SV: login(dto)
        SV->>DB: find user by username
        alt user not found
            SV->>AU: log LOGIN_FAILED
            SV-->>CT: throw 401
            CT-->>FE: 401 invalid credentials
        else LOCKED
            SV->>AU: log LOGIN_FAILED
            SV-->>CT: throw 403
            CT-->>FE: 403 account locked
        else INACTIVE
            SV->>AU: log LOGIN_FAILED
            SV-->>CT: throw 403
            CT-->>FE: 403 account inactive
        else ACTIVE
            SV->>SV: bcrypt.compare
            alt password invalid
                SV->>AU: log LOGIN_FAILED
                SV-->>CT: throw 401
                CT-->>FE: 401 invalid credentials
            else password valid
                SV->>DB: create refresh token (SHA-256)
                SV->>AU: log LOGIN_SUCCESS
                SV-->>CT: tokens + user
                CT-->>FE: 201 tokens + user
                FE-->>U: Logged in
            end
        end
    end

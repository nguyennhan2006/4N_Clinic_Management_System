%% SEQ-P1-03 — Update Examination / Diagnosis (UC10) — AS-BUILT
%% Source: backend/src/modules/examinations/examinations.service.ts::update
%% Roles: DOCTOR, ADMIN | Endpoint: PATCH /examinations/:id
%% No audit event for this UC.
sequenceDiagram
    autonumber
    actor DR as Doctor
    participant FE as React SPA
    participant GD as JwtAuthGuard + RolesGuard
    participant CT as ExaminationsController
    participant SV as ExaminationsService
    participant TX as Prisma $transaction
    participant DB as PostgreSQL

    DR->>FE: Enter symptoms / notes / conclusion / diagnoses
    FE->>GD: PATCH /examinations/:id {symptoms, clinicalNotes, conclusion, diagnoses?} + token
    GD->>GD: verify JWT + role in {DOCTOR, ADMIN}
    alt not authorized
        GD-->>FE: 401 / 403
    else authorized
        GD->>CT: proceed to handler
        note over CT: ValidationPipe checks DTO
        alt invalid DTO
            CT-->>FE: 400 BadRequestException
        else valid DTO
            CT->>SV: update(id, dto)
            SV->>DB: examination.findUnique(id)
            alt not found
                DB-->>SV: null
                SV-->>CT: throw NotFoundException
                CT-->>FE: 404 "Examination not found"
            else found
                alt status COMPLETED or CANCELLED
                    SV-->>CT: throw BadRequestException
                    CT-->>FE: 400 "Cannot edit examination with status ..."
                else status OPEN
                    opt diagnoses provided
                        alt more than one primary
                            SV-->>CT: throw BadRequestException
                            CT-->>FE: 400 "At most one primary diagnosis is allowed"
                        else primary count <= 1
                            SV->>DB: disease.findMany(id in [...], isActive=true)
                            alt some disease invalid/inactive
                                SV-->>CT: throw BadRequestException
                                CT-->>FE: 400 "Some diseases are invalid or inactive"
                            else all active
                                note over SV: build diagnosisRows with name = disease.name (snapshot)
                            end
                        end
                    end
                    rect rgb(235,235,255)
                        note over TX: BEGIN $transaction
                        SV->>TX: run
                        TX->>DB: examination.update(symptoms, clinicalNotes, conclusion)
                        opt diagnoses provided
                            TX->>DB: diagnosis.deleteMany(examinationId)
                            TX->>DB: diagnosis.createMany(name snapshot, diseaseId, isPrimary)
                        end
                        TX->>DB: examination.findUniqueOrThrow(include diagnoses)
                        note over TX: COMMIT
                    end
                    SV-->>CT: examination (+ diagnoses)
                    CT-->>FE: 200 {examination}
                    FE-->>DR: Examination saved
                end
            end
        end
    end

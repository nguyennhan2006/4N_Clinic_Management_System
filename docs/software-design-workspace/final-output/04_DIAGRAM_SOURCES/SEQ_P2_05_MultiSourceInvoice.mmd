%% SEQ-P2-05 — Multi-source Invoice (PLANNED Phase 2A)
%% Source: MODE_C_CONTEXT.md §3.7 BR-P2-13/14/15, §3.9 (Visit -> Invoice)
%% Canonical: InvoiceItem.itemType/referenceType/referenceId; all prices snapshot
%% Roles: CASHIER, ADMIN | Endpoint: POST /visits/:visitId/invoice (extended)
sequenceDiagram
    autonumber
    actor CA as Cashier
    participant FE as React SPA
    participant GD as JwtAuthGuard + RolesGuard
    participant CT as BillingController
    participant SV as BillingService
    participant TX as Prisma $transaction
    participant DB as PostgreSQL
    participant AU as AuditService

    note over CT,SV: PLANNED Phase 2A — extends Phase 1 BillingService
    CA->>FE: Issue invoice for a completed visit
    FE->>GD: POST /visits/:visitId/invoice + token
    GD->>GD: verify JWT + role in {CASHIER, ADMIN}
    alt not authorized
        GD-->>FE: 401 / 403
    else authorized
        GD->>CT: proceed to handler
        CT->>SV: createInvoiceFromVisit(visitId, actorId)
        SV->>DB: visit.findUnique(include examination, serviceOrders, dispenseItems, invoice)
        alt visit not found
            DB-->>SV: null
            SV-->>CT: throw NotFoundException
            CT-->>FE: 404 "Visit not found"
        else status != COMPLETED
            SV-->>CT: throw BadRequestException
            CT-->>FE: 400 "Only COMPLETED visit can be invoiced"
        else COMPLETED
            rect rgb(235,235,255)
                note over TX: BEGIN $transaction — BR-P2-13/14
                SV->>TX: run
                TX->>DB: read consultation fee (active regulation, snapshot)
                note over TX: collect items: exam fee + COMPLETED ServiceOrders + DispenseItems
                loop each source line
                    note over TX: dedupe by (referenceType, referenceId) — BR-P2-14
                    TX->>DB: invoiceItem build(itemType, unitPriceSnapshot, referenceType, referenceId)
                end
                TX->>DB: invoice.create(status=ISSUED, nested items)
                note over TX: COMMIT
            end
            SV->>AU: log(CREATE_INVOICE)
            note right of AU: append-only, after COMMIT
            SV-->>CT: invoice (+ items)
            CT-->>FE: 201 {invoice}
            FE-->>CA: Invoice issued (multi-source)
        end
    end
    note over SV: BR-P2-15 — VOID is rejected once any payment exists

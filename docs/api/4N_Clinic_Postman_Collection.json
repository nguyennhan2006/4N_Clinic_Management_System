          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/visits/{{visitId}}/open-examination", "host": ["{{baseUrl}}"], "path": ["visits", "{{visitId}}", "open-examination"] }
          }
        },
        {
          "name": "POST /visits/:id/open-examination — Visit không tồn tại → 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/visits/00000000-0000-0000-0000-000000000000/open-examination", "host": ["{{baseUrl}}"], "path": ["visits", "00000000-0000-0000-0000-000000000000", "open-examination"] }
          }
        }
      ]
    },
    {
      "name": "05. Examinations (UC-10, UC-12, UC-13)",
      "item": [
        {
          "name": "GET /examinations/:id — Chi tiết phiếu khám",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/examinations/{{examId}}", "host": ["{{baseUrl}}"], "path": ["examinations", "{{examId}}"] }
          }
        },
        {
          "name": "PATCH /examinations/:id — Cập nhật phiếu khám (UC-10)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }

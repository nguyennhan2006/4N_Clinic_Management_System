            "body": {
              "mode": "raw",
              "raw": "{\n  \"symptoms\": \"Đau đầu từng cơn, sổ mũi, ho khan 3 ngày\",\n  \"clinicalNotes\": \"Huyết áp 120/80 mmHg, nhiệt độ 37.8°C, SpO2 98%\",\n  \"conclusion\": \"Cảm cúm thông thường, kê đơn nghỉ ngơi và thuốc\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/examinations/{{examId}}", "host": ["{{baseUrl}}"], "path": ["examinations", "{{examId}}"] }
          }
        },
        {
          "name": "PATCH /examinations/:id — Thêm diagnosis",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnoses\": [\n    {\n      \"diseaseId\": \"{{diseaseId}}\",\n      \"isPrimary\": true\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/examinations/{{examId}}", "host": ["{{baseUrl}}"], "path": ["examinations", "{{examId}}"] }
          }
        },
        {
          "name": "POST /examinations/:id/prescription — Tạo đơn thuốc (lần đầu)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Uống sau bữa ăn, đủ liệu trình 5 ngày\",\n  \"items\": [\n    {\n      \"drugId\": \"{{drugId}}\",\n      \"quantity\": 10,\n      \"dosage\": \"1 viên/lần × 2 lần/ngày\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/examinations/{{examId}}/prescription", "host": ["{{baseUrl}}"], "path": ["examinations", "{{examId}}", "prescription"] }
          }
        },
        {
          "name": "PUT /examinations/:id/prescription — Thay thế đơn thuốc (UC-12)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Đơn thuốc đã cập nhật — uống trước bữa ăn\",\n  \"items\": [\n    {\n      \"drugId\": \"{{drugId}}\",\n      \"quantity\": 14,\n      \"dosage\": \"2 viên/lần × 1 lần/ngày (sáng)\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/examinations/{{examId}}/prescription", "host": ["{{baseUrl}}"], "path": ["examinations", "{{examId}}", "prescription"] }
          }
        },
        {
          "name": "POST /examinations/:id/complete — Hoàn tất khám (UC-13)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/examinations/{{examId}}/complete", "host": ["{{baseUrl}}"], "path": ["examinations", "{{examId}}", "complete"] }
          }
        },
        {
          "name": "PATCH /examinations/:id — Sửa sau COMPLETED → 400",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symptoms\": \"Cố sửa sau khi đã hoàn tất — phải nhận 400\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/examinations/{{examId}}", "host": ["{{baseUrl}}"], "path": ["examinations", "{{examId}}"] }
          }
        }
      ]
    },

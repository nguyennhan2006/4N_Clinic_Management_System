{
  "info": {
    "name": "4N Clinic Management System",
    "description": "API collection cho toàn bộ UC-07 → UC-20. Base URL: http://localhost:3000/api/v1\n\nCách dùng:\n1. Import file này vào Postman\n2. Chạy '01. Login' để lấy token → token tự động lưu vào variable\n3. Chạy các request theo thứ tự trong folder\n\nAccounts seed sẵn:\n- admin@clinic.local / Admin@123456\n- doctor@clinic.local / Doctor@123456\n- receptionist@clinic.local / Reception@123456\n- cashier@clinic.local / Cashier@123456\n- manager@clinic.local / Manager@123456",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "patientId", "value": "", "type": "string" },
    { "key": "visitId", "value": "", "type": "string" },
    { "key": "examId", "value": "", "type": "string" },
    { "key": "invoiceId", "value": "", "type": "string" },
    { "key": "diseaseId", "value": "", "type": "string" },
    { "key": "drugId", "value": "", "type": "string" },
    { "key": "regulationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "  console.log('Token saved:', json.accessToken.slice(0, 30) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@clinic.local\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Doctor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('token', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@clinic.local\",\n  \"password\": \"Doctor@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Receptionist)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('token', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"receptionist@clinic.local\",\n  \"password\": \"Reception@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Cashier)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('token', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cashier@clinic.local\",\n  \"password\": \"Cashier@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('token', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@clinic.local\",\n  \"password\": \"Manager@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Login sai password → 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@clinic.local\",\n  \"password\": \"WrongPassword\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "02. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "03. Patients (UC-06)",
      "item": [
        {
          "name": "POST /patients — Tạo bệnh nhân mới",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('patientId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn Postman\",\n  \"dob\": \"1990-05-15\",\n  \"gender\": \"MALE\",\n  \"phone\": \"0901234567\",\n  \"address\": \"123 Đường ABC, TP.HCM\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/patients", "host": ["{{baseUrl}}"], "path": ["patients"] }
          }
        },
        {
          "name": "GET /patients — Tìm kiếm bệnh nhân",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/patients?keyword=Nguyễn",
              "host": ["{{baseUrl}}"],
              "path": ["patients"],
              "query": [{ "key": "keyword", "value": "Nguyễn" }]
            }
          }
        },
        {
          "name": "GET /patients/:id — Chi tiết bệnh nhân",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/patients/{{patientId}}", "host": ["{{baseUrl}}"], "path": ["patients", "{{patientId}}"] }
          }
        },
        {
          "name": "GET /patients/:id/medical-history — Lịch sử khám (UC-11)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/patients/{{patientId}}/medical-history", "host": ["{{baseUrl}}"], "path": ["patients", "{{patientId}}", "medical-history"] }
          }
        },
        {
          "name": "GET /patients — Không có token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/patients", "host": ["{{baseUrl}}"], "path": ["patients"] }
          }
        }
      ]
    },
    {
      "name": "04. Visits (UC-07, UC-08, UC-09)",
      "item": [
        {
          "name": "POST /visits — Tạo lượt khám (UC-07)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('visitId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"visitDate\": \"2026-05-18\",\n  \"reason\": \"Đau đầu, sổ mũi\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/visits", "host": ["{{baseUrl}}"], "path": ["visits"] }
          }
        },
        {
          "name": "GET /visits — Danh sách theo ngày (UC-08)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/visits?date=2026-05-18",
              "host": ["{{baseUrl}}"],
              "path": ["visits"],
              "query": [{ "key": "date", "value": "2026-05-18" }]
            }
          }
        },
        {
          "name": "GET /visits — Filter status=WAITING",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/visits?date=2026-05-18&status=WAITING",
              "host": ["{{baseUrl}}"],
              "path": ["visits"],
              "query": [
                { "key": "date", "value": "2026-05-18" },
                { "key": "status", "value": "WAITING" }
              ]
            }
          }
        },
        {
          "name": "POST /visits/:id/open-examination — Mở khám (UC-09)",
          "event": [
            {
              "listen": "test",
